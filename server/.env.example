# API server
PORT=4000
CORS_ORIGIN=http://localhost:5173
AUTH_SECRET=change-this-secret
DATABASE_URL=postgresql://cvstack:cvstack@localhost:5432/cvstack?schema=public
UPLOAD_DIR=./uploads
ENABLE_DEV_SEED=true
OPENAI_TIMEOUT_MS=60000
OPENAI_CURATE_TIMEOUT_MS=120000
OPENAI_SECOND_PASS_MIN_REMAINING_MS=45000
OPENAI_CURATE_DISABLE_TIMEOUT=true
OPENAI_CURATE_SECOND_PASS=false

# Legacy JSON source used only by db:migrate-json
DB_FILE=./data/db.json

# Optional seed script defaults
SEED_EMAIL=demo@cvstack.dev
SEED_PASSWORD=demo12345
